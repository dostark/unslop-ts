{
  "name": "@dostark/unslop-ts-hosts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "pretest:node": "node ./link_node_modules.mjs",
    "pretest:bun": "node ./link_node_modules.mjs",
    "test:node": "cd .. && node --test \"tests_node/**/*.test.mjs\"",
    "test:bun": "cd .. && bun test tests_node/",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:oxlint": "cd .. && node --test tests_node/oxlint_example.mjs"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "10.0.1",
    "@typescript-eslint/parser": "8.72.0",
    "eslint": "10.13.0",
    "eslint-9": "npm:eslint@9.39.5",
    "eslint-floor": "npm:eslint@9.0.0",
    "oxlint": "1.88.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "zod": "4.4.3"
  }
}
