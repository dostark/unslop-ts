{
  "name": "@dostark/unslop-ts",
  "version": "0.1.1",
  "license": "MIT",
  "exports": {
    ".": "./mod.ts",
    "./cli/rule_ceiling": "./src/cli/rule_ceiling.ts",
    "./whole-tree": "./src/rules/whole_tree/mod.ts",
    "./cli": "./src/cli/unslop.ts",
    "./deno": "./deno.ts",
    "./report": "./src/report/mod.ts",
    "./eslint": "./eslint.ts"
  },
  "imports": {
    "@dostark/unslop-ts": "./mod.ts",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/fs": "jsr:@std/fs@^1.0.24",
    "@std/path": "jsr:@std/path@^1.1.6",
    "ajv": "npm:ajv@8.17.1",
    "ajv/": "npm:/ajv@8.17.1/",
    "ajv-formats": "npm:ajv-formats@3.0.1",
    "ajv-draft-04": "npm:ajv-draft-04@1.0.0",
    "typescript": "npm:typescript@6.0.3",
    "zod": "npm:zod@^4.4.3"
  },
  "tasks": {
    "test": "deno test --allow-all",
    "lint": "deno lint --config=deno.json",
    "check": "deno check mod.ts deno.ts eslint.ts src/report/mod.ts src/ src/bundle/engine.ts tests/ examples/lint_plugin.ts examples/unslop.project.ts examples/eslint/sample.ts scripts/bundle.ts examples/node-project/sample.ts examples/bun-project/sample.ts",
    "fmt": "deno fmt",
    "cli": "deno run --allow-read --allow-env src/cli/unslop.ts",
    "cli:write": "deno run --allow-read --allow-write --allow-env src/cli/unslop.ts",
    "unslop": "deno run --allow-read --allow-env src/cli/unslop.ts",
    "unslop:write": "deno run --allow-read --allow-write --allow-env src/cli/unslop.ts",
    "cli:report": "deno run --allow-read --allow-env --allow-run=deno src/cli/unslop.ts",
    "cli:report:write": "deno run --allow-read --allow-write --allow-env --allow-run=deno src/cli/unslop.ts",
    "bundle": "deno run --allow-read --allow-write --allow-env --allow-run=deno scripts/bundle.ts",
    "unslop:report": "deno run --allow-read --allow-env --allow-run=deno src/cli/unslop.ts",
    "unslop:report:write": "deno run --allow-read --allow-write --allow-env --allow-run=deno src/cli/unslop.ts"
  },
  "compilerOptions": {
    "lib": [
      "deno.window",
      "deno.ns",
      "deno.unstable"
    ],
    "strict": true,
    "checkJs": false
  },
  "fmt": {
    "exclude": [
      "tests/fixtures/host_config/eslint_fragment.mjs",
      "tests/fixtures/report_markdown_golden.md",
      "tests/fixtures/sarif-2.1.0-schema.json"
    ],
    "useTabs": false,
    "lineWidth": 120,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "proseWrap": "preserve"
  },
  "lint": {
    "rules": {
      "exclude": []
    },
    "exclude": [
      "scripts/"
    ],
    "plugins": [
      "./lint/plugin.ts"
    ]
  },
  "test": {
    "exclude": [
      "tests_node/",
      "hosts/"
    ]
  },
  "publish": {
    "exclude": [
      "hosts/",
      "node_modules/",
      "tests_node/",
      "examples/node-project/",
      "examples/bun-project/",
      "dist/"
    ]
  }
}
