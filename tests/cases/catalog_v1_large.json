      "severity": "error",
      "scope": "all",
      "tags": [
        "complexity"
      ]
    },
    "demo/require-optional-wrapper": {
      "engine": "plugin",
      "severity": "error",
      "scope": "all",
      "tags": [
        "optional-parameters"
      ]
    },
    "demo/import-inside-statement": {
      "engine": "plugin",
      "severity": "error",
      "scope": "all",
      "tags": [
        "imports"
      ]
    },
    "demo/dynamic-import": {
      "engine": "plugin",
      "severity": "error",
      "scope": "all",
      "tags": [
        "imports"
      ]
    },
    "demo/inline-type-import": {
