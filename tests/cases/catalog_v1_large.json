{
  "version": "1",
  "scopes": {
    "test": [
      "**/*_test.ts"
    ],
    "fixture": [
      "**/tests/fixtures/**"
    ]
  },
  "layout": {
    "root1": [
      "src/area1/**",
      "tests/area1/**"
    ],
    "root2": [
      "src/area2/**",
      "tests/area2/**"
    ],
    "root3": [
      "src/area3/**",
      "tests/area3/**"
    ],
    "root4": [
      "src/area4/**",
      "tests/area4/**"
    ],
    "root5": [
      "src/area5/**",
      "tests/area5/**"
    ],
    "root6": [
      "src/area6/**",
      "tests/area6/**"
    ],
    "root7": [
      "src/area7/**",
      "tests/area7/**"
    ],
    "root8": [
      "src/area8/**",
      "tests/area8/**"
    ],
    "root9": [
      "src/area9/**",
      "tests/area9/**"
    ],
    "root10": [
      "src/area10/**",
      "tests/area10/**"
    ],
    "root11": [
      "src/area11/**",
      "tests/area11/**"
    ],
    "root12": [
      "src/area12/**",
      "tests/area12/**"
    ]
  },
  "wholeTree": {
    "optionalParams": {
      "wrapperType": "Opt",
      "wrapperImport": "@demo/types",
      "reasonExamples": [
        "OptionalContext"
      ],
      "testSegments": [
        "/tests/"
      ],
      "testSuffixes": [
        "_test.ts"
      ],
      "skipSegments": [
        "/fixtures/"
      ],
      "walkSkipSegments": [
        "/vendor/"
      ],
      "pluginRuleId": "demo/require-optional-wrapper"
    },
    "unusedExports": {
      "productionRoots": [
        "src"
      ],
      "testSegments": [
        "/tests/"
      ],
      "testSuffixes": [
        "_test.ts"
      ],
      "entrypointSuffixes": [
        "/mod.ts"
      ],
      "mainEntrypointSuffixes": [
        "/main.ts"
      ],
      "scriptRoot": "scripts",
      "walkSkipPatterns": [
        "node_modules"
      ],
      "strictSkipPrefixes": [
        "src/vendor/"
      ],
      "strictSkipSegments": [
        "/generated/"
      ]
    },
    "constantRestatement": {
      "constantModules": [
        "src/constants.ts"
      ],
      "testRoots": [
        "tests"
      ],
      "minRestatedElements": 2
    },
    "magicLiterals": {
      "checkNumbers": false,
      "minNumber": 42,
      "additionalStrings": [
        "legacy"
      ]
    }
  },
  "tagVocabulary": {
    "type-safety": {
      "description": "Rules that keep type evidence."
    },
    "imports": {
      "description": "Rules about where imports sit and which imports are explicit."
    },
    "boundaries": {
      "description": "Rules about what a file group may import."
    },
    "interfaces": {
      "description": "Rules about interface names, renames, and placement."
    },
    "magic-values": {
      "description": "Rules about repeated literals and duplicated declarations."
    },
    "module-structure": {
      "description": "Rules about module layout and exports."
    },
    "test-quality": {
      "description": "Rules about test fixtures and assertions."
    },
    "scripts": {
      "description": "Rules about runnable script headers."
    },
    "complexity": {
      "description": "Rules about function and class size."
    },
    "optional-parameters": {
      "description": "Rules about how optional parameters are declared."
    },
    "comments": {
      "description": "Rules about comment content and length."
    }
  },
  "ignore": [
    {
      "glob": "**/vendor1/**",
      "reason": "Vendored area 1."
    },
    {
      "glob": "**/vendor2/**",
      "reason": "Vendored area 2."
    },
    {
      "glob": "**/vendor3/**",
      "reason": "Vendored area 3."
    },
    {
      "glob": "**/vendor4/**",
      "reason": "Vendored area 4."
    }
  ],
  "rules": {
    "demo/no-chained-type-assertions": {
      "engine": "plugin",
      "severity": "error",
      "scope": "all",
      "tags": [
        "type-safety"
      ]
    },
    "demo/no-explicit-unknown": {
      "engine": "plugin",
      "severity": "error",
      "scope": "all",
      "tags": [
        "type-safety"
      ]
    },
    "demo/no-unsafe-dictionary": {
      "engine": "plugin",
      "severity": "error",
      "scope": "all",
      "tags": [
        "type-safety"
      ]
    },
    "demo/no-typeof-escape": {
      "engine": "plugin",
      "severity": "error",
      "scope": "all",
      "tags": [
        "type-safety"
      ]
    },
    "demo/no-pass-through-type-alias": {
