      ]
    },
    "demo/promise-response-alias": {
      "engine": "plugin",
      "severity": "error",
      "scope": "all",
      "tags": [
        "type-safety"
      ]
    },
    "demo/promise-response-return": {
      "engine": "plugin",
      "severity": "error",
      "scope": "all",
      "tags": [
        "type-safety"
      ]
    },
    "demo/ts-suppression-pragmas": {
      "engine": "plugin",
      "severity": "error",
      "scope": "all",
      "tags": [
        "type-safety"
      ]
    },
    "demo/magic-union-type": {
