      "severity": "error",
      "scope": "all",
      "tags": [
        "type-safety"
      ]
    },
    "demo/no-runtime-typeof": {
      "engine": "plugin",
      "severity": "error",
      "scope": "all",
      "tags": [
        "type-safety"
      ]
    },
    "demo/no-conditional-empty-object-spread": {
